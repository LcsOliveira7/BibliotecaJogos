<div class="header-explorar">
    <nav>
        <div class="botao-header-explorar">
            <a href="/explorar">
                <button class="<%= !categoriaSelecionada ? 'ativo' : '' %>">
                    Todas
                </button>
            </a>
        </div>

        <% categorias.forEach(function(categoria) { %>
            <div class="botao-header-explorar">
                <a href="/explorar?categoria=<%= categoria.categoriaID %>">
                    <button class="<%= Number(categoriaSelecionada) === categoria.categoriaID ? 'ativo' : '' %>">
                        <%= categoria.categoriaNome %>
                    </button>
                </a>
            </div>
        <% }); %>
    </nav>
</div>