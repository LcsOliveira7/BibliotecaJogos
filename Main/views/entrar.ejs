<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar - The Game Library</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <h1 class="h1-explorar">Entrar na Conta</h1>

    <div class="div-recomendar">
        <form class="form-recomendar" action="/login" method="POST">
            <div class="elemento-div">
                <div class="recomendar-elemento">
                    <label for="email">E-mail:</label>
                    <input type="email" id="email" name="email" placeholder="Seu e-mail" required>
                </div>
            </div>

            <div class="elemento-div">
                <div class="recomendar-elemento">
                    <label for="senha">Senha:</label>
                    <input type="password" id="senha" name="senha" placeholder="Sua senha" required>
                </div>
            </div>

            <div class="elemento-div">
                <div class="recomendar-elemento">
                    <button type="submit" class="botao-header">Entrar</button>
                </div>
            </div>
        </form>
    </div>

    <p style="text-align: center; margin-bottom: 20px;">
        Ainda não tem conta? <a href="/cadastrar" style="color: rgb(180, 100, 200);">Cadastre-se</a>
    </p>

    <%- include('partials/footer') %>
</body>
</html>