<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorar - The Game Library</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/header-explorar') %>

            <main>
                <h1 class="h1-explorar">Encontre seus jogos favoritos aqui!</h1>
                <div class="area-busca-jogos">
                    <input type="search" id="busca-jogos" placeholder="Pesquisar jogo pelo nome..."
                        aria-label="Pesquisar jogo pelo nome">
                </div>
                <div class="jogos-body">
                    <% if (typeof jogos !=='undefined' && jogos.length> 0) { %>
                        <% jogos.forEach(function(jogo) { %>
                            <a href="/jogo/<%= jogo.id %>" class="link-jogo" data-nome="<%= jogo.nome %>">
                                <div class="capa-jogo">
                                    <div class="capa-titulo">
                                        <%= jogo.nome %>
                                    </div>

                                    <img class="capa-img" src="<%= jogo.imagem %>"
                                        onerror="this.onerror=null; this.src='/images/erroImagem.png';"
                                        alt="<%= jogo.nome %>">

                                    <div class="capa-desc">
                                        <%= jogo.descricao %>
                                    </div>
                                </div>
                            </a>
                            <% }); %>
                                <% } else { %>
                                    <p class="subtitulo">Nenhum jogo encontrado com essa categoria.</p>
                                    <% } %>
                </div>
            </main>

            <%- include('partials/footer') %>

                <script>
                    const busca = document.getElementById("busca-jogos");
                    const jogos = document.querySelectorAll(".link-jogo");

                    busca.addEventListener("input", function () {
                        const texto = busca.value.trim().toLocaleLowerCase("pt-BR");

                        jogos.forEach(jogo => {
                            const nome = jogo.dataset.nome.toLocaleLowerCase("pt-BR");

                            jogo.style.display = nome.includes(texto) ? "" : "none";
                        });
                    });
                </script>
</body>

</html>